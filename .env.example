# ============================================================
# BAJRIWALA WEBSITE — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to `.env.local` for local development and add the
# same variables in the Vercel project settings for production.
#
# Every variable below is PUBLIC (NEXT_PUBLIC_*) and is safe to expose
# to the browser. Never place API keys, database credentials or
# payment gateway secrets in this file.
#
# Any variable left empty degrades gracefully:
#   - store badges stay visible but link to the on-page download section
#   - contact / WhatsApp fall back to customer-app support defaults in
#     lib/site-config.ts (override with live values when ready)
#   - social icons are hidden until a value is provided
#   - analytics is not loaded at all
# ============================================================

# Canonical site URL (no trailing slash). Used for metadata, OG tags,
# sitemap.xml and robots.txt. Leave empty in local development until the
# production domain is confirmed.
NEXT_PUBLIC_SITE_URL=

# ---- App store links -------------------------------------------------
# Paste the real listing URLs. The buttons start working immediately.
# Google Play: https://play.google.com/store/apps/details?id=<package.name>
# App Store:   https://apps.apple.com/in/app/<slug>/id<numeric-id>
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=

# ---- Contact details -------------------------------------------------
# Defaults (when empty): support@bajriwala.com / +91 99999 99999 /
# https://wa.me/919999999999 — same as the customer app. Replace with
# live production details in Vercel when ready.
# NEXT_PUBLIC_CONTACT_EMAIL=support@bajriwala.com
# NEXT_PUBLIC_CONTACT_PHONE=+91 99999 99999
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/919999999999
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_URL=

# ---- Social profiles -------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Registered company name for legal pages, e.g. Bajriwala Private Limited
NEXT_PUBLIC_LEGAL_ENTITY=

# ---- Analytics (optional) -------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave empty to skip loading analytics entirely.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
